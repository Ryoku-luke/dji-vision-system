[TYPECHECK]
# cv2 (OpenCV) is a C extension; pylint cannot introspect its members
# cv2 是 C 扩展, pylint 无法内省其成员
# torch/tensorrt/ultralytics/openvino/psutil are optional dependencies that
# may not be installed in all environments (e.g. CI code-quality job)
# torch/tensorrt/ultralytics/openvino/psutil 是可选依赖, 部分环境可能未安装
ignored-modules = cv2, torch, tensorrt, ultralytics, openvino, psutil

[FORMAT]
# messages.py contains long bilingual string literals that cannot be wrapped
# messages.py 包含无法换行的双语字符串字面量
max-line-length = 200
